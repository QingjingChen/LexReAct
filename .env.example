# OpenAI-compatible chat/completions endpoint used by src/llm_client.py
# DashScope:
LLM_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
# Company LLM Center (intranet; connect via Feilian first). Take the exact API base from the LLM Center user guide:
# LLM_API_URL=https://<llm-center API base>/v1/chat/completions
LLM_API_KEY=
# default model id (python src/llm_client.py --models lists the ids available to your key)
LLM_MODEL=qwen-plus
