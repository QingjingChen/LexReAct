    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8514"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8537"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8541"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8633"/></lrml:Association>
