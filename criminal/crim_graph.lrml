    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8749"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8751"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8773"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8776"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8794"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8807"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8837"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8841"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8895"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8898"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8978"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8995"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8917"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t8921"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t9282"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t9284"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t9314"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t9319"/></lrml:Association>
    <lrml:Association><lrml:appliesAuthority keyref="#graph"/><lrml:appliesStrength iri="lrmlv:Strict"/><lrml:toTarget keyref="#tx-t9609"/></lrml:Association>
