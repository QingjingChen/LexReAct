 {"id": "stage-2", "title": "着手入户盗窃后良心发现自动离开，未造成损害（中止）",
  "facts": ["adult(a)", "takesSecretly(a,x)", "illegalPossessionPurpose(a,x)", "burglaryOfHome(x)", "commencedExecution(a,x)", "notAccomplished(x)", "voluntarilyAbandoned(a,x)"],
  "expect": ["discontinuance(a,x)", "!attempt(a,x)", "O sentence(a,x,exempt)"]},
 {"id": "rec-1", "title": "盗窃罪刑满释放三年后又故意伤害，应判有期徒刑（累犯）",
