[
 {"id": "age-1", "title": "15岁的甲盗窃同学手机（数额较大）",
  "facts": ["age14to16(jia)", "takesSecretly(jia,x)", "illegalPossessionPurpose(jia,x)", "amountRelativelyLarge(x)"],
