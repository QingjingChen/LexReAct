                <lrml:ConstitutiveStatement key="k270"><lrml:Comment>将代为保管的他人财物非法占为己有，数额较大，拒不退还的（第270条第1款；npc）</lrml:Comment><ruleml:Rule closure="universal" key=":k270"><ruleml:if><ruleml:And><ruleml:Atom><ruleml:Rel iri="cnv:entrustedPropertyOf"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:illegallyAppropriates"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:amountRelativelyLarge"/><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:refusesToReturn"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var></ruleml:Atom></ruleml:And></ruleml:if><ruleml:then><ruleml:Atom><ruleml:Rel iri="cnv:constitutes"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var><ruleml:Ind>embezzlementOfEntrusted</ruleml:Ind></ruleml:Atom></ruleml:then></ruleml:Rule></lrml:ConstitutiveStatement>
              <lrml:ConstitutiveStatement key="k270-2"><lrml:Comment>将他人的遗忘物或者埋藏物非法占为己有，数额较大，拒不交出的（第270条第2款；npc）</lrml:Comment><ruleml:Rule closure="universal" key=":k270-2"><ruleml:if><ruleml:And><ruleml:Or><ruleml:Atom><ruleml:Rel iri="cnv:forgottenProperty"/><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:buriedProperty"/><ruleml:Var>X</ruleml:Var></ruleml:Atom></ruleml:Or><ruleml:Atom><ruleml:Rel iri="cnv:illegallyAppropriates"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:amountRelativelyLarge"/><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:refusesToHandOver"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var></ruleml:Atom></ruleml:And></ruleml:if><ruleml:then><ruleml:Atom><ruleml:Rel iri="cnv:constitutes"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var><ruleml:Ind>embezzlementOfEntrusted</ruleml:Ind></ruleml:Atom></ruleml:then></ruleml:Rule></lrml:ConstitutiveStatement>
