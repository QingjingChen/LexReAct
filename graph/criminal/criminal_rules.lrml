                <lrml:ConstitutiveStatement key="k-convict"><lrml:Comment>符合构成要件且负刑事责任、未过追诉时效的，以该罪定罪（罪刑法定，第3条）（第3条；doctrine）</lrml:Comment><ruleml:Rule closure="universal" key=":k-convict"><ruleml:if><ruleml:And><ruleml:Atom><ruleml:Rel iri="cnv:constitutes"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var><ruleml:Var>C</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:responsible"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var><ruleml:Var>C</ruleml:Var></ruleml:Atom><ruleml:Naf><ruleml:Atom><ruleml:Rel iri="cnv:notProsecuted"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var></ruleml:Atom></ruleml:Naf></ruleml:And></ruleml:if><ruleml:then><ruleml:Atom><ruleml:Rel iri="cnv:convicted"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var><ruleml:Var>C</ruleml:Var></ruleml:Atom></ruleml:then></ruleml:Rule></lrml:ConstitutiveStatement>
