    <lrml:OverrideStatement key="ov-k21-1--k17-2-arson"><lrml:Comment>正当化事由阻却</lrml:Comment><lrml:Override over="#k21-1" under="#k17-2-arson"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k21-1--k17-2-explosion"><lrml:Comment>正当化事由阻却</lrml:Comment><lrml:Override over="#k21-1" under="#k17-2-explosion"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k21-1--k17-2-poisoning"><lrml:Comment>正当化事由阻却</lrml:Comment><lrml:Override over="#k21-1" under="#k17-2-poisoning"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k21-1--k17-1"><lrml:Comment>紧急避险阻却</lrml:Comment><lrml:Override over="#k21-1" under="#k17-1"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k20-late--k20-cond"><lrml:Comment>事后防卫不具备时间条件</lrml:Comment><lrml:Override over="#k20-late" under="#k20-cond"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k389-3--k389"><lrml:Comment>被勒索且未获不正当利益的，不是行贿</lrml:Comment><lrml:Override over="#k389-3" under="#k389"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k88-1--k87-under5"><lrml:Comment>逃避侦查审判</lrml:Comment><lrml:Override over="#k88-1" under="#k87-under5"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k88-1--k87-from5to10"><lrml:Comment>逃避侦查审判</lrml:Comment><lrml:Override over="#k88-1" under="#k87-from5to10"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k88-1--k87-from10"><lrml:Comment>逃避侦查审判</lrml:Comment><lrml:Override over="#k88-1" under="#k87-from10"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k88-1--k87-lifeOrDeath"><lrml:Comment>逃避侦查审判</lrml:Comment><lrml:Override over="#k88-1" under="#k87-lifeOrDeath"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k88-2--k87-under5"><lrml:Comment>应立案不立案</lrml:Comment><lrml:Override over="#k88-2" under="#k87-under5"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k88-2--k87-from5to10"><lrml:Comment>应立案不立案</lrml:Comment><lrml:Override over="#k88-2" under="#k87-from5to10"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k88-2--k87-from10"><lrml:Comment>应立案不立案</lrml:Comment><lrml:Override over="#k88-2" under="#k87-from10"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k88-2--k87-lifeOrDeath"><lrml:Comment>应立案不立案</lrml:Comment><lrml:Override over="#k88-2" under="#k87-lifeOrDeath"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k-conv-absorb--k-convict"><lrml:Comment>转化抢劫吸收前罪</lrml:Comment><lrml:Override over="#k-conv-absorb" under="#k-convict"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k74--k72"><lrml:Comment>累犯、首要分子不适用缓刑</lrml:Comment><lrml:Override over="#k74" under="#k72"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k74--k72-must"><lrml:Comment>累犯、首要分子不适用缓刑</lrml:Comment><lrml:Override over="#k74" under="#k72-must"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k81-2--k81-1"><lrml:Comment>累犯及严重暴力犯罪长刑犯不得假释</lrml:Comment><lrml:Override over="#k81-2" under="#k81-1"/></lrml:OverrideStatement>
    <lrml:OverrideStatement key="ov-k24-noAttempt--k23"><lrml:Comment>自动放弃的不是未遂</lrml:Comment><lrml:Override over="#k24-noAttempt" under="#k23"/></lrml:OverrideStatement>
  </lrml:Statements>
</lrml:LegalRuleML>
