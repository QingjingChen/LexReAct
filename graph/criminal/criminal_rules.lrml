                <lrml:ConstitutiveStatement key="k264"><lrml:Comment>盗窃公私财物，数额较大，或者多次盗窃、入户盗窃、携带凶器盗窃、扒窃的（第264条；npc）</lrml:Comment><ruleml:Rule closure="universal" key=":k264"><ruleml:if><ruleml:And><ruleml:Atom><ruleml:Rel iri="cnv:takesSecretly"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:illegalPossessionPurpose"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Or><ruleml:Atom><ruleml:Rel iri="cnv:amountRelativelyLarge"/><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:multipleTheft"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:burglaryOfHome"/><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:carryingWeapon"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var></ruleml:Atom><ruleml:Atom><ruleml:Rel iri="cnv:pickpocketing"/><ruleml:Var>X</ruleml:Var></ruleml:Atom></ruleml:Or></ruleml:And></ruleml:if><ruleml:then><ruleml:Atom><ruleml:Rel iri="cnv:constitutes"/><ruleml:Var>P</ruleml:Var><ruleml:Var>X</ruleml:Var><ruleml:Ind>theft</ruleml:Ind></ruleml:Atom></ruleml:then></ruleml:Rule></lrml:ConstitutiveStatement>
