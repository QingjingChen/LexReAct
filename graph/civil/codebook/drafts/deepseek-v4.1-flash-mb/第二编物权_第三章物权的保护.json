     ]
    },
    {
     "text": "原物已不存在，返还原物请求权无从行使（学理）",
     "rules": [
      "c235-doc-noexist"
     ]
    },
    {
     "text": "第三人已善意取得标的物，原权利人的返还原物请求权受限制（学理）",
     "rules": [
      "c235-doc-goodfaith"
     ]
    }
   ],
   "effects": [
    {
     "text": "利害关系人可以请求确认权利，包括确认所有权与确认他物权",
     "rules": [
      "c234-1"
     ]
    },
    {
     "text": "权利人可以请求无权占有人返还原物",
     "rules": [
      "c235-1"
     ]
    },
    {
     "text": "权利人可以请求排除妨害",
     "rules": [
      "c236-1"
     ]
    },
    {
     "text": "物权有被妨害之虞的，权利人可以请求消除危险",
     "rules": [
      "c236-2"
     ]
    },
    {
     "text": "权利人可以依法请求修理、重作、更换或者恢复原状",
     "rules": [
      "c237-1"
     ]
    },
    {
     "text": "权利人可以依法请求损害赔偿，也可以依法请求承担其他民事责任",
     "rules": [
      "c238-1"
     ]
    },
    {
     "text": "上述物权保护方式可以单独适用，也可以根据权利被侵害的情形合并适用",
     "rules": [
      "c239-1"
     ]
    }
   ],
   "priority": [
    {
     "text": "确认物权通常是其他物权保护的前提，权利基础不明时应优先确认（学理）",
     "rules": [
      "c234-1"
     ]
    },
    {
     "text": "返还原物等物权请求权不适用诉讼时效，而损害赔偿请求权适用诉讼时效（学理）",
     "rules": [
      "c235-doc-limitation",
      "c238-doc-limitation"
     ]
    },
    {
     "text": "抵押权人无占有权能、原物已不存在、第三人善意取得等情形，排除或限制返还原物请求权（学理）",
     "rules": [
      "c235-doc-mortgagee",
      "c235-doc-noexist",
      "c235-doc-goodfaith"
     ]
    }
   ],
   "distinguish": [
    {
     "text": "确认物权之诉解决权利归属与内容，损害赔偿之诉补偿经济损失，二者功能不同",
     "rules": []
    },
    {
     "text": "返还原物、排除妨害、消除危险等属基于物权的请求权，与基于合同或侵权的债权请求权不同",
     "rules": []
    },
    {
     "text": "LEGO 卡片称修理、重作、更换仅适用于动产，法条未作此限制；恢复原状对不动产同样适用，该说法仅作参考",
     "rules": []
    },
    {
     "text": "第239条第2款“第二分编 所有权”为分编标题，非规范内容，不产生规则",
     "rules": []
    }
   ]
