      "c236-1",
      "c236-2",
      "c237-1",
      "c238-1",
      "c238-2",
      "c239-1"
     ]
    }
   ],
   "conditions": [
    {
     "text": "他人的行为妨害物权，或者可能妨害物权；妨害指以占有以外的方式影响物权的圆满状态，危险指尚未实际发生但有可能出现的妨害",
     "rules": [
      "c236-1",
      "c236-2",
      "c236-def-obstruction",
      "c236-def-danger"
     ]
    },
    {
     "text": "不动产或者动产因他人行为而毁损",
     "rules": [
      "c237-1"
     ]
    },
    {
     "text": "侵害物权并造成权利人损害",
     "rules": [
      "c238-1",
      "c238-2"
     ]
    },
    {
     "text": "请求人须为物权人：所有人可以主张，直接占有物的用益物权人也可以主张",
     "rules": [
      "c236-1",
      "c236-2",
      "c236-usufruct",
      "c237-1",
      "c238-1"
