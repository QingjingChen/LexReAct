 "card:g6110": {
  "status": "ok",
  "model": "deepseek-v4.1-flash-mb",
  "attempts": 1,
  "errors": [],
  "nl": {
   "issue": [
    {
     "text": "自然人享有的生命权、身体权、健康权的内容与保护范围，以及任何组织或者个人不得侵害的义务",
     "rules": [
      "c1002-1",
      "c1002-2",
      "c1003-1",
      "c1003-2",
      "c1004-1",
      "c1004-2"
     ]
    },
    {
     "text": "人体细胞、人体组织、人体器官、遗体能否捐献、由谁决定、采何形式，以及买卖的效力",
     "rules": [
      "c1006-1",
      "c1006-1b",
      "c1006-2",
      "c1006-3",
      "c1006-3b",
      "c1007-1",
      "c1007-2"
     ]
    },
    {
     "text": "临床试验与人体基因、人体胚胎等医学科研活动的合法要件",
     "rules": [
      "c1008-1",
      "c1008-2",
      "c1009"
     ]
    },
    {
     "text": "性骚扰、非法剥夺或限制行动自由、非法搜查身体的民事责任，以及单位的防治义务",
     "rules": [
      "c1010-1",
      "c1010-2",
      "c1011"
     ]
    }
   ],
   "conditions": [
    {
     "text": "权利主体限于自然人；生命权以生命安全、生命尊严为客体，身体权以身体完整与行动自由为内容，健康权以身心健康为内容",
     "rules": [
      "c1002-1",
      "c1003-1",
      "c1004-1"
     ]
    },
    {
     "text": "生前捐献须为完全民事行为能力人依法自主决定，且为无偿",
     "rules": [
      "c1006-1"
     ]
    },
    {
     "text": "死后捐献须该自然人生前未表示不同意捐献，并由其配偶、成年子女、父母共同决定（全票决）",
     "rules": [
      "c1006-3"
     ]
    },
    {
     "text": "临床试验须为研制新药、医疗器械或者发展新的预防和治疗方法而进行",
     "rules": [
      "c1008-1"
     ]
    },
    {
     "text": "性骚扰须违背他人意愿，以言语、文字、图像、肢体行为等方式实施",
     "rules": [
      "c1010-1"
     ]
    },
    {
     "text": "侵害身体权的情形包括以非法拘禁等方式剥夺、限制他人行动自由，或者非法搜查他人身体",
     "rules": [
      "c1011"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "自然人生前已表示不同意捐献的，其死亡后配偶、成年子女、父母不得决定捐献",
     "rules": [
      "c1006-3"
     ]
    },
    {
     "text": "捐献须无偿；以任何形式买卖人体细胞、组织、器官、遗体的，不属于合法捐献，买卖行为无效",
     "rules": [
      "c1007-1",
      "c1007-2"
     ]
    }
   ],
   "effects": [
    {
     "text": "任何组织或者个人不得侵害他人的生命权、身体权、健康权",
     "rules": [
      "c1002-2",
      "c1003-2",
      "c1004-2"
     ]
    },
    {
     "text": "任何组织或者个人不得强迫、欺骗、利诱完全民事行为能力人捐献",
     "rules": [
      "c1006-1b"
     ]
    },
    {
     "text": "同意捐献应当采用书面形式，也可以订立遗嘱；死后共同决定捐献亦应当采用书面形式",
     "rules": [
      "c1006-2",
      "c1006-3b"
     ]
    },
    {
     "text": "违反禁止买卖规定的买卖行为无效",
     "rules": [
      "c1007-2"
     ]
    },
    {
     "text": "临床试验应当依法经相关主管部门批准、经伦理委员会审查同意，向受试者或其监护人告知试验目的、用途和可能风险等详细情况并取得书面同意；不得向受试者收取试验费用",
     "rules": [
      "c1008-1",
      "c1008-2"
     ]
    },
    {
     "text": "从事与人体基因、人体胚胎等有关的医学和科研活动，应当遵守法律、行政法规和国家有关规定，不得危害人体健康、违背伦理道德、损害公共利益",
     "rules": [
      "c1009"
     ]
    },
    {
     "text": "性骚扰的受害人有权依法请求行为人承担民事责任；机关、企业、学校等单位应当采取合理的预防、受理投诉、调查处置等措施，防止和制止利用职权、从属关系等实施性骚扰",
     "rules": [
      "c1010-1",
      "c1010-2"
     ]
    },
    {
     "text": "以非法拘禁等方式剥夺、限制他人行动自由或者非法搜查他人身体的，受害人有权依法请求行为人承担民事责任",
     "rules": [
      "c1011"
     ]
    }
   ],
   "priority": [
    {
     "text": "买卖人体细胞、组织、器官、遗体的行为无效，优先于捐献同意规则：捐献以无偿为要件，有偿“捐献”不因同意而有效",
     "rules": [
      "c1007-2",
      "c1006-1"
     ]
    },
    {
     "text": "生命权是自然人最基本的人格权，为其他民事权利的前提和基础（学理，条文未明定优先顺序）",
     "rules": [
      "c1002-1"
     ]
    }
   ],
   "distinguish": [
    {
     "text": "生命权、身体权、健康权虽同属物质性人格权，但客体不同：生命权以生命安全与生命尊严为客体，身体权以身体完整与行动自由为客体，健康权以身体生理机能的正常运作与完善发挥（含心理健康）为客体",
     "rules": []
    },
    {
     "text": "笔记将性骚扰、医学研究侵害健康权列为侵害健康权的类型，条文分别规定在第1010条、第1009条，而非第1004条",
     "rules": [
      "c1010-1",
      "c1009"
     ]
    },
    {
     "text": "笔记将非法搜查身体、剥夺或限制行动自由列为侵害身体权的类型，条文单列于第1011条，与第1003条的身体权宣示条款相衔接",
     "rules": [
      "c1011"
     ]
    },
    {
     "text": "生命权、身体权、健康权的主体限于自然人，法人、非法人组织不享有（学理与LEGO卡片，条文未明文排除）",
     "rules": []
    },
    {
     "text": "生命利益支配权（献身、参加危险竞技、安乐死）属学理讨论，条文仅规定生命权受保护，未作规定",
     "rules": []
    }
   ]
  },
