  "nl": {
   "issue": [
    {
     "text": "自然人的生命权、身体权、健康权受到侵害或者处于其他危难情形时，谁负有及时施救的义务",
     "rules": [
      "c1005-1"
     ]
    }
   ],
   "conditions": [
    {
     "text": "受害人为自然人，其生命权、身体权、健康权受到侵害，或者处于其他危难情形",
     "rules": [
      "c1005-1"
     ]
    },
    {
     "text": "义务人为依法负有法定救助义务的组织或者个人（其主体与范围由其他法律确定）",
     "rules": [
      "c1005-1",
      "c1005-duty"
     ]
    }
   ],
   "exceptions": [],
   "effects": [
    {
     "text": "负有法定救助义务的组织或者个人应当及时施救",
     "rules": [
      "c1005-1"
     ]
    }
   ],
   "priority": [],
   "distinguish": [
    {
     "text": "本条为引致性规定：只确立“及时施救”的义务，救助义务的主体与具体内容由其他法律、行政法规规定，本条不自行创设救助义务人",
     "rules": [
      "c1005-duty"
     ]
    },
    {
     "text": "笔记未引用本条原文或条号，本条无笔记层面的例外或体系说明可采",
     "rules": []
    }
   ]
  },
