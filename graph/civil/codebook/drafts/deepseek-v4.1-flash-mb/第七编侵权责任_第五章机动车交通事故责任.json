 "card:g7708": {
  "status": "ok",
  "model": "deepseek-v4.1-flash-mb",
  "attempts": 1,
  "errors": [],
  "nl": {
   "issue": [
    {
     "text": "机动车所有人、管理人与使用人不是同一人（租赁、借用、转让并交付未登记、挂靠经营、未经允许驾驶、盗窃抢劫抢夺等）时，交通事故损害赔偿责任由谁承担",
     "rules": [
      "c1209-1",
      "c1209-2",
      "c1210",
      "c1211",
      "c1212-1",
      "c1212-2",
      "c1214",
      "c1215-1",
      "c1215-2"
     ]
    },
    {
     "text": "驾驶人逃逸、机动车不明或未参加强制保险时，保险人的赔偿、道路交通事故社会救助基金的垫付及追偿",
     "rules": [
      "c1215-3",
      "c1216-1",
      "c1216-2",
      "c1216-3"
     ]
    },
    {
     "text": "非营运机动车无偿搭乘人因交通事故受损时，使用人的赔偿责任是否减轻",
     "rules": [
      "c1217",
      "c1217-exc"
     ]
    }
   ],
   "conditions": [
    {
     "text": "发生交通事故造成损害，且属于该机动车一方责任",
     "rules": [
      "c1209-1",
      "c1209-2",
      "c1210",
      "c1211",
      "c1212-1",
      "c1212-2",
      "c1217"
     ]
    },
    {
     "text": "因租赁、借用等情形，机动车所有人、管理人与使用人不是同一人",
     "rules": [
      "c1209-1",
      "c1209-2"
     ]
    },
    {
     "text": "已以买卖或者其他方式转让并交付机动车，但未办理登记",
     "rules": [
      "c1210"
     ]
    },
    {
     "text": "以挂靠形式从事道路运输经营活动",
     "rules": [
      "c1211"
     ]
    },
    {
     "text": "未经允许驾驶他人机动车",
     "rules": [
      "c1212-1",
      "c1212-2"
     ]
    },
    {
     "text": "以买卖或者其他方式转让拼装或者已达到报废标准的机动车",
     "rules": [
      "c1214"
     ]
    },
    {
     "text": "机动车系盗窃、抢劫或者抢夺所得",
     "rules": [
      "c1215-1",
      "c1215-2"
     ]
    },
    {
     "text": "所有人、管理人对损害的发生有过错：知道或者应当知道机动车存在缺陷且该缺陷为事故原因之一、驾驶人无驾驶资格或未取得相应驾驶资格、驾驶人依法不能驾驶机动车，以及其他应认定有过错的情形",
     "rules": [
      "c1209-2",
      "c1209-fault",
      "c1212-2"
     ]
    },
    {
     "text": "驾驶人发生交通事故后逃逸，且该机动车参加强制保险",
     "rules": [
      "c1216-1"
     ]
    },
    {
     "text": "机动车不明、未参加强制保险或者抢救费用超过强制保险责任限额，需要支付被侵权人人身伤亡的抢救、丧葬等费用",
     "rules": [
      "c1216-2"
     ]
    },
    {
     "text": "非营运机动车发生交通事故造成无偿搭乘人损害",
     "rules": [
      "c1217",
      "c1217-exc"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "机动车使用人有故意或者重大过失的，不减轻其赔偿责任",
     "rules": [
      "c1217-exc"
     ]
    },
    {
     "text": "未经允许驾驶他人机动车时，所有人、管理人的过错相应责任以本章另有规定为限（但书）",
     "rules": [
      "c1212-2"
     ]
    }
   ],
   "effects": [
    {
     "text": "租赁、借用及未经允许驾驶情形下，由机动车使用人承担赔偿责任",
     "rules": [
      "c1209-1",
      "c1212-1"
     ]
    },
    {
     "text": "所有人、管理人对损害的发生有过错的，承担相应的赔偿责任，与使用人之间为按份责任",
     "rules": [
      "c1209-2",
      "c1209-several",
      "c1212-2"
     ]
    },
    {
     "text": "转让并交付但未办理登记的，由受让人承担赔偿责任",
     "rules": [
      "c1210"
     ]
    },
    {
     "text": "挂靠经营的，由挂靠人和被挂靠人承担连带责任",
     "rules": [
      "c1211"
     ]
    },
    {
     "text": "转让拼装或者报废机动车的，由转让人和受让人承担连带责任",
     "rules": [
      "c1214"
     ]
    },
    {
     "text": "盗窃、抢劫、抢夺的机动车致害，由盗窃人、抢劫人或者抢夺人承担赔偿责任；其与使用人不是同一人时，二者承担连带责任",
     "rules": [
      "c1215-1",
      "c1215-2"
     ]
    },
    {
     "text": "保险人在强制保险责任限额范围内垫付抢救费用的，有权向交通事故责任人追偿",
     "rules": [
      "c1215-3"
     ]
    },
    {
     "text": "逃逸且该车参加强制保险的，由保险人在强制保险责任限额范围内赔偿",
     "rules": [
      "c1216-1"
     ]
    },
    {
     "text": "机动车不明、未参加强制保险或者抢救费用超限额的，由道路交通事故社会救助基金垫付抢救、丧葬等费用",
     "rules": [
      "c1216-2"
     ]
    },
    {
     "text": "救助基金垫付后，其管理机构有权向交通事故责任人追偿",
     "rules": [
      "c1216-3"
     ]
    },
    {
     "text": "无偿搭乘人受损且属于机动车一方责任的，应当减轻使用人的赔偿责任",
     "rules": [
      "c1217"
     ]
    }
   ],
   "priority": [
    {
     "text": "第1217条但书优先：使用人有故意或者重大过失的，不适用减轻赔偿责任",
     "rules": [
      "c1217-exc"
     ]
    },
    {
     "text": "转让拼装或者报废机动车的连带责任（第1214条）优先于第1210条受让人单独承担赔偿责任",
     "rules": [
      "c1214"
     ]
    },
    {
     "text": "盗窃、抢劫、抢夺机动车属特别情形，优先于第1212条未经允许驾驶的一般规则",
     "rules": [
      "c1215-1"
     ]
    },
    {
     "text": "无偿搭乘减轻责任是特别规定，优先于一般过错责任",
     "rules": [
      "c1217"
     ]
    }
   ],
   "distinguish": [
    {
     "text": "笔记中机动车之间、机动车与行人、非机动车之间的责任分担（过错比例分担、无过错时不超过百分之十、行人故意碰撞免责）属第1208条、第1213条内容，本行未挂载，不设规则",
     "rules": []
    },
    {
     "text": "笔记中的套牌机动车责任（同意套牌者连带、擅自套牌由套牌者承担）系司法解释规定，不在本行挂载法条内，不设规则",
     "rules": []
