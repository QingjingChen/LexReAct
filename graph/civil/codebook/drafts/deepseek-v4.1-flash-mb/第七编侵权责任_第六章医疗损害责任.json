 "card:g7757": {
  "status": "ok",
  "model": "deepseek-v4.1-flash-mb",
  "attempts": 1,
  "errors": [],
  "nl": {
   "issue": [
    {
     "text": "患者在诊疗活动中受到损害，具备哪些情形可以推定医疗机构有过错",
     "rules": [
      "c1222-presume",
      "c1222-fault"
     ]
    },
    {
     "text": "因药品、消毒产品、医疗器械缺陷或者输入不合格血液致害，患者可以向谁请求赔偿，医疗机构赔偿后能否追偿",
     "rules": [
      "c1223-1",
      "c1223-2",
      "c1223-3"
     ]
    },
    {
     "text": "患者在诊疗活动中受到损害，哪些情形下医疗机构不承担赔偿责任",
     "rules": [
      "c1224-1",
      "c1224-2"
     ]
    }
   ],
   "conditions": [
    {
     "text": "医疗损害责任的构成（笔记四要件）：医疗机构及其医务人员实施违法的诊疗行为；患者遭受非正常损害；违法诊疗行为与损害之间有因果关系；医疗机构或医务人员有过错",
     "rules": [
      "c1222-liable"
     ]
    },
    {
     "text": "推定过错的三项事由：违反法律、行政法规、规章以及其他有关诊疗规范的规定；隐匿或者拒绝提供与纠纷有关的病历资料；遗失、伪造、篡改或者违法销毁病历资料",
     "rules": [
      "c1222-presume"
     ]
    },
    {
     "text": "因药品、消毒产品、医疗器械的缺陷，或者输入不合格的血液造成患者损害",
     "rules": [
      "c1223-1",
      "c1223-2"
     ]
    },
    {
     "text": "免责事由：患者或其近亲属不配合医疗机构进行符合诊疗规范的诊疗；医务人员在抢救生命垂危的患者等紧急情况下已尽到合理诊疗义务；限于当时的医疗水平难以诊疗",
     "rules": [
      "c1224-1"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "推定过错可以被推翻：医疗机构举证证明自己没有过错的，不认定其有过错",
     "rules": [
      "c1222-fault"
     ]
    },
    {
     "text": "具备第1224条第1款三项情形之一的，医疗机构不承担赔偿责任",
     "rules": [
      "c1224-1"
     ]
    },
    {
     "text": "患者一方不配合的情形中，医疗机构或者其医务人员也有过错的，仍应当承担相应的赔偿责任",
     "rules": [
      "c1224-2"
     ]
    }
   ],
   "effects": [
    {
     "text": "具备第1222条三项情形之一的，推定医疗机构有过错，患者无须就具体过错举证",
     "rules": [
      "c1222-presume",
      "c1222-fault"
     ]
    },
    {
     "text": "构成医疗损害责任的，由医疗机构（责任主体）向患者承担侵权赔偿责任",
     "rules": [
      "c1222-liable",
      "c1222-pay"
     ]
    },
    {
     "text": "医疗产品、不合格血液致害的，患者可以向药品上市许可持有人、生产者、血液提供机构请求赔偿，也可以向医疗机构请求赔偿（不真正连带）",
     "rules": [
      "c1223-1",
      "c1223-2"
     ]
    },
    {
     "text": "患者向医疗机构请求赔偿的，医疗机构赔偿后有权向负有责任的药品上市许可持有人、生产者、血液提供机构追偿",
     "rules": [
      "c1223-3"
     ]
    },
    {
     "text": "具备免责事由的，医疗机构不承担赔偿责任",
     "rules": [
      "c1224-1"
     ]
    }
   ],
   "priority": [
    {
     "text": "第1222条的过错推定一旦成立，即认定医疗机构有过错，除非其举证证明自己无过错",
     "rules": [
      "c1222-fault",
      "c1222-liable"
     ]
    },
    {
     "text": "第1224条第1款的免责规定排除依第1222条推定过错而生的赔偿责任",
     "rules": [
      "c1224-1"
     ]
    },
    {
     "text": "第1224条第2款（医疗机构也有过错仍承担相应责任）优先于第1款第1项的免责",
     "rules": [
      "c1224-2"
     ]
    }
   ],
   "distinguish": [
    {
     "text": "笔记将医疗损害责任列为一般侵权（过错责任），第1222条仅为例外的过错推定；与第1223条医疗产品责任（不真正连带＋追偿）不同，后者不以医疗机构过错为要件",
     "rules": []
