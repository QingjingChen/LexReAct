  "nl": {
   "issue": [
    {
     "text": "继承从何时开始；被宣告死亡的人以何日为死亡日期",
     "rules": [
      "c1121-1",
      "c48-judgment",
      "c48-accident",
      "c48-death"
     ]
    },
    {
     "text": "相互有继承关系的数人在同一事件中死亡、难以确定死亡时间时，如何推定死亡顺序",
     "rules": [
      "c1121-2a",
      "c1121-2b",
      "c1121-2c"
     ]
    },
    {
     "text": "继承开始后，由谁负责通知其他继承人和遗嘱执行人",
     "rules": [
      "c1150-1",
      "c1150-2"
     ]
    }
   ],
   "conditions": [
    {
     "text": "被继承人死亡（生理死亡或者被宣告死亡）",
     "rules": [
      "c1121-1",
      "c48-death"
     ]
    },
    {
     "text": "被宣告死亡：有宣告死亡判决及其作出之日；因意外事件下落不明的，有意外事件发生之日",
     "rules": [
      "c48-judgment",
      "c48-accident"
     ]
    },
    {
     "text": "相互有继承关系的数人在同一事件中死亡，且难以确定死亡时间；其中一人没有其他继承人，或者数人都有其他继承人而辈份不同或相同",
     "rules": [
      "c1121-2a",
      "c1121-2b",
      "c1121-2c"
     ]
    },
    {
     "text": "继承已经开始，且某继承人知道被继承人死亡",
     "rules": [
      "c1150-1"
     ]
    },
    {
     "text": "继承人中无人知道被继承人死亡，或者知道但不能通知；被继承人有生前所在单位，或者住所地有居民委员会、村民委员会",
     "rules": [
      "c1150-2"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "因意外事件下落不明被宣告死亡的，不适用判决作出之日，而以意外事件发生之日为死亡日期",
     "rules": [
      "c48-accident"
     ]
    },
    {
     "text": "数人都有其他继承人时，不适用“没有其他继承人的人先死亡”的推定，改按辈份推定",
     "rules": [
      "c1121-2b",
      "c1121-2c"
     ]
    },
    {
     "text": "辈份相同的，推定同时死亡，相互不发生继承",
     "rules": [
      "c1121-2c"
     ]
    }
   ],
   "effects": [
    {
     "text": "继承自被继承人死亡时开始",
     "rules": [
      "c1121-1"
     ]
    },
    {
     "text": "宣告死亡判决作出之日（意外事件情形下为意外事件发生之日）视为死亡日期，并据此认定死亡",
     "rules": [
      "c48-judgment",
      "c48-accident",
      "c48-death"
     ]
    },
    {
     "text": "推定没有其他继承人的人先死亡；都有其他继承人且辈份不同的，推定长辈先死亡；辈份相同的，推定同时死亡且相互不发生继承",
     "rules": [
      "c1121-2a",
      "c1121-2b",
      "c1121-2c"
     ]
    },
    {
     "text": "知道被继承人死亡的继承人应当及时通知其他继承人和遗嘱执行人",
     "rules": [
      "c1150-1"
     ]
    },
    {
     "text": "无人知道死亡或者知道而不能通知的，由被继承人生前所在单位或者住所地的居民委员会、村民委员会负责通知",
     "rules": [
      "c1150-2"
     ]
    }
   ],
   "priority": [
    {
     "text": "因意外事件下落不明宣告死亡的，以意外事件发生之日为死亡日期，优先于判决作出之日",
     "rules": [
      "c48-accident"
     ]
    },
    {
     "text": "数人都有其他继承人时，按辈份推定先死亡或同时死亡，优先于“没有其他继承人的人先死亡”的推定",
     "rules": [
      "c1121-2b",
      "c1121-2c"
     ]
    }
   ],
   "distinguish": [
    {
     "text": "继承开始的时间（死亡时）不同于遗产分割的时间；宣告死亡被撤销后的婚姻、收养等效果由第50—52条处理，本行挂载法条不涉及",
     "rules": []
    },
    {
     "text": "LEGO 卡片把继承权的取得、放弃、丧失等一并列入，本行挂载法条只涉及继承开始时间与继承开始的通知，故对放弃、丧失继承权不作形式化",
