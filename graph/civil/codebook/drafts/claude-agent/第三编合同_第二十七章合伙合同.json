  "chapter": [
   "第三编　合同",
   "第二十七章　合伙合同"
  ],
  "nl": {
   "issue": [
    {
     "text": "合伙合同的效力：出资、合伙财产、事务决定与执行、报酬、损益分配、连带责任与追偿、份额转让、债权人代位限制、合伙期限",
     "rules": [
      "c968-g5870",
      "c969-1g5870"
     ]
    }
   ],
   "conditions": [
    {
     "text": "合伙人的出资、因合伙事务依法取得的收益和其他财产属于合伙财产",
     "rules": [
      "c969-1g5870"
     ]
    },
    {
     "text": "合伙期限无约定或不明确且依第510条仍不能确定的，视为不定期合伙；期限届满后继续执行事务而其他合伙人无异议的，原合同继续有效但为不定期",
     "rules": [
      "c976-1g5870",
      "c976-2g5870"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "事务决定的一致同意规则、执行事务不得请求报酬、份额对外转让须一致同意：合伙合同另有约定的除外",
     "rules": [
      "c970-1g5870",
      "c971-g5870",
      "c974-g5870"
     ]
    },
    {
     "text": "合伙人的债权人不得代位行使合伙人权利，但利益分配请求权除外",
     "rules": [
      "c975-g5870",
      "c975-excg5870"
     ]
    }
   ],
   "effects": [
    {
     "text": "合伙人按约定的出资方式、数额和缴付期限履行出资义务",
     "rules": [
      "c968-g5870"
     ]
    },
    {
     "text": "合伙合同终止前，合伙人不得请求分割合伙财产",
     "rules": [
      "c969-2g5870"
     ]
    },
    {
     "text": "合伙事务决定经全体一致同意；事务由全体共同执行，可按约定或全体决定委托一个或数个合伙人执行，其他合伙人不再执行但有权监督",
     "rules": [
      "c970-1g5870",
      "c970-2ag5870",
      "c970-entg5870",
      "c970-2cg5870"
     ]
    },
    {
     "text": "分别执行时，执行事务合伙人可对他人执行的事务提出异议，提出异议后应暂停该项事务",
     "rules": [
      "c970-3ag5870",
      "c970-3bg5870"
     ]
    },
    {
     "text": "利润分配和亏损分担：先约定，后协商，再按实缴出资比例，无法确定比例的平均",
     "rules": [
      "c972-1g5870",
      "c972-2g5870",
      "c972-3g5870",
      "c972-4g5870"
     ]
    },
    {
     "text": "合伙人对合伙债务承担连带责任；清偿超过自己份额的，有权向其他合伙人追偿",
     "rules": [
      "c973-1g5870",
      "c973-2g5870"
     ]
    },
    {
     "text": "不定期合伙合同可以随时解除，但应在合理期限之前通知其他合伙人",
     "rules": [
      "c976-3g5870",
      "c976-ntcg5870"
     ]
    }
   ],
   "priority": [],
   "distinguish": [
    {
     "text": "笔记：一个或数个合伙人不履行出资义务的，其他合伙人不能因此拒绝出资（学理，未单独形式化）",
     "rules": []
    }
   ]
  },
