  "chapter": [
   "第三编　合同",
   "第十九章　运输合同"
  ],
  "nl": {
   "issue": [
    {
     "text": "运输合同的概念；客运、货运与多式联运中承运人、旅客、托运人的主要权利义务与责任",
     "rules": [
      "c809",
      "c810",
      "c838"
     ]
    }
   ],
   "conditions": [
    {
     "text": "运输合同：承运人将旅客或货物从起运地点运输到约定地点，旅客、托运人或收货人支付票款或运输费用",
     "rules": [
      "c809"
     ]
    },
    {
     "text": "无票、超程、越级乘坐或持不符合减价条件的优惠客票乘坐，构成违规乘坐",
     "rules": [
      "c815-irreg"
     ]
    },
    {
     "text": "承运人迟延运输或有其他不能正常运输情形",
     "rules": [
      "c820-dis"
     ]
    },
    {
     "text": "货物毁损、灭失由不可抗力、货物自然性质或合理损耗、托运人或收货人过错造成，且由承运人证明",
     "rules": [
      "c832-exc"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "迟延等造成旅客损失不可归责于承运人的，承运人不赔偿",
     "rules": [
      "c820-comp"
     ]
    },
    {
     "text": "承运人证明法定免责事由的，对货物毁损、灭失不承担赔偿责任",
     "rules": [
      "c832-1",
      "c832-exc"
     ]
    },
    {
     "text": "运费风险规则：法律另有规定的依其规定；留置权：当事人另有约定的除外",
     "rules": [
      "c835-1",
      "c835-2",
      "c836"
     ]
    }
   ],
   "effects": [
    {
     "text": "从事公共运输的承运人不得拒绝通常、合理的运输要求（强制缔约）",
     "rules": [
      "c810"
     ]
    },
    {
     "text": "旅客按有效客票乘坐；违规乘坐应补交票款，承运人可按规定加收，旅客不支付的可拒绝运输",
     "rules": [
      "c815-ride",
      "c815-pay",
      "c815-refuse"
     ]
    },
    {
     "text": "实名制客运旅客丢失客票可请求挂失补办，承运人不得再次收取票款和其他不合理费用",
     "rules": [
      "c815-2"
     ]
    },
    {
     "text": "承运人严格履行安全运输义务并告知注意事项；旅客应协助配合合理的安全安排",
     "rules": [
      "c819-1",
      "c819-2"
     ]
    },
    {
     "text": "承运人按客票运输；迟延或不能正常运输时及时告知提醒、采取安置措施，依旅客要求改乘或退票，并赔偿由此造成的损失",
     "rules": [
      "c820-1",
      "c820-dis",
      "c820-2",
      "c820-3",
      "c820-comp"
     ]
    },
    {
     "text": "随身携带物品毁损灭失，承运人有过错才赔偿；托运行李适用货物运输规定",
     "rules": [
      "c824-1",
      "c824-2"
     ]
    },
    {
     "text": "托运人提交审批、检验手续文件；按约定方式包装，无约定或不明确适用第619条；违反包装义务承运人可拒绝运输",
     "rules": [
      "c826",
      "c827-1",
      "c827-619",
      "c827-2"
     ]
    },
    {
     "text": "交付收货人前托运人可要求中止运输、返还货物、变更到达地或交给其他收货人，但应赔偿承运人损失",
     "rules": [
      "c829",
      "c829-comp"
     ]
    },
    {
     "text": "承运人对运输过程中货物毁损、灭失承担赔偿责任（无过错责任）",
     "rules": [
      "c832-1"
     ]
    },
    {
     "text": "货物因不可抗力灭失：未收运费的不得请求，已收的托运人可请求返还",
     "rules": [
      "c835-1",
      "c835-2"
     ]
    },
    {
     "text": "托运人或收货人不付运费、保管费等，承运人对相应货物享有留置权",
     "rules": [
      "c836"
     ]
    },
    {
     "text": "收货人不明或无正当理由拒绝受领，承运人可依法提存货物",
     "rules": [
      "c837"
     ]
    },
    {
     "text": "多式联运经营人负责履行或组织履行，享有承运人权利、承担承运人义务，对全程运输负责；可与区段承运人约定内部责任但不影响全程义务",
     "rules": [
      "c838",
      "c839-1",
      "c839-whole"
     ]
    },
    {
     "text": "多式联运经营人收货时签发多式联运单据，按托运人要求为可转让或不可转让单据",
     "rules": [
      "c840-1",
      "c840-2"
     ]
    },
    {
     "text": "托运人托运时过错造成经营人损失的，即使已转让单据仍应赔偿",
     "rules": [
      "c841"
     ]
    },
    {
     "text": "毁损灭失区段确定的，赔偿责任和限额适用该区段运输方式的法律；不能确定的依本章规定",
     "rules": [
      "c842-1",
      "c842-2"
     ]
    }
   ],
   "priority": [
    {
     "text": "承运人的法定免责事由排除第832条的赔偿责任",
     "rules": [
      "c832-exc"
     ]
    }
   ],
   "distinguish": [
    {
     "text": "笔记：旅客人身伤亡承运人负无过错责任（第823条，不在本行）；随身物品为过错责任，托运行李为无过错责任；搭便车属好意施惠，只能主张侵权",
     "rules": []
    }
   ]
  },
