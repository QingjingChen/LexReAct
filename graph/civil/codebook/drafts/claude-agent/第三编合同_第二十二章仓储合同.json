  "chapter": [
   "第三编　合同",
   "第二十二章　仓储合同"
  ],
  "nl": {
   "issue": [
    {
     "text": "仓储合同的概念，保管人与存货人（仓单持有人）的主要义务，储存期限与提取，保管人的赔偿责任及免责",
     "rules": [
      "c904",
      "c917-1",
      "c917-exc"
     ]
    }
   ],
   "conditions": [
    {
     "text": "仓储合同：保管人储存存货人交付的仓储物，存货人支付仓储费（有偿、诺成）",
     "rules": [
      "c904"
     ]
    },
    {
     "text": "存货人或者仓单持有人",
     "rules": [
      "c911-holder"
     ]
    },
    {
     "text": "储存期内因保管不善造成仓储物毁损、灭失",
     "rules": [
      "c917-1"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "因仓储物本身的自然性质、包装不符合约定或超过有效储存期造成变质、损坏的，保管人不承担赔偿责任",
     "rules": [
      "c917-exc"
     ]
    }
   ],
   "effects": [
    {
     "text": "储存危险物品或易变质物品，存货人应说明性质、提供资料；违反的，保管人可拒收或采取措施避免损失，费用由存货人负担；保管人储存危险物品应具备相应保管条件",
     "rules": [
      "c906-1",
      "c906-2",
      "c906-cost",
      "c906-3"
     ]
    },
    {
     "text": "保管人按约定验收，发现不符及时通知存货人；验收后发生品种、数量、质量不符的，保管人赔偿",
     "rules": [
      "c907-1",
      "c907-2",
      "c907-3"
     ]
    },
    {
     "text": "保管人应同意存货人或仓单持有人检查仓储物或提取样品",
     "rules": [
      "c911"
     ]
    },
    {
     "text": "发现变质或其他损坏应及时通知；危及其他仓储物安全的应催告其作出必要处置，情况紧急可自行处置但事后及时通知",
     "rules": [
      "c912",
      "c913-1",
      "c913-2",
      "c913-3"
     ]
    },
    {
     "text": "储存期限无约定或不明确的，双方均可随时提取或请求提取，但保管人应给予必要准备时间",
     "rules": [
      "c914"
     ]
    },
    {
     "text": "期限届满凭仓单、入库单提取；逾期提取加收仓储费，提前提取不减收",
     "rules": [
      "c915-1",
      "c915-late",
      "c915-early"
     ]
    },
    {
     "text": "届满不提取的，保管人可催告在合理期限内提取，逾期不提取的可以提存",
     "rules": [
      "c916-1",
      "c916-2"
     ]
    },
    {
     "text": "保管人对保管不善造成的毁损、灭失向存货人赔偿",
     "rules": [
      "c917-comp"
     ]
    }
   ],
   "priority": [
    {
     "text": "第917条第2句的免责事由优先于保管不善的赔偿责任",
     "rules": [
      "c917-exc"
     ]
    }
   ],
   "distinguish": [
    {
     "text": "仓储合同为双务、有偿、诺成合同；一般保管合同多为无偿、实践合同",
     "rules": []
    }
   ]
  },
