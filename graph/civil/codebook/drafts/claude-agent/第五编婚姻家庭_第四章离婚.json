   "第五编　婚姻家庭",
   "第四章　离婚"
  ],
  "nl": {
   "issue": [
    {
     "text": "离婚时夫妻共同财产的分割",
     "rules": [
      "c1087-agree",
      "c1087-court",
      "c1087-2",
      "c1092-1",
      "c1092-2",
      "c1092-spc84"
     ]
    },
    {
     "text": "离婚时夫妻共同债务的清偿",
     "rules": [
      "c1089-1",
      "c1089-agree",
      "c1089-court"
     ]
    },
    {
     "text": "离婚损害赔偿",
     "rules": [
      "c1091-fault",
      "c1091",
      "c1091-spc87"
     ]
    }
   ],
   "conditions": [
    {
     "text": "离婚损害赔偿：一方有重婚、与他人同居、实施家庭暴力、虐待遗弃家庭成员或其他重大过错，并因此导致离婚；请求方为无过错方",
     "rules": [
      "c1091-fault",
      "c1091"
     ]
    },
    {
     "text": "一方隐藏、转移、变卖、毁损、挥霍夫妻共同财产，或者伪造夫妻共同债务企图侵占另一方财产",
     "rules": [
      "c1092-1",
      "c1092-2"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "司法解释：人民法院判决不准离婚的，对离婚损害赔偿请求不予支持；婚姻关系存续期间不起诉离婚而单独请求损害赔偿的，不予受理；双方均有过错的，不予支持（第90条，体现为“无过错方”要件）",
     "rules": [
      "c1091-spc87",
      "c1091"
     ]
    }
   ],
   "effects": [
    {
     "text": "共同财产由双方协议处理；协议不成的，由人民法院按照照顾子女、女方和无过错方权益的原则判决",
     "rules": [
      "c1087-agree",
      "c1087-court"
     ]
    },
    {
     "text": "夫或妻在家庭土地承包经营中享有的权益等，应当依法予以保护",
     "rules": [
      "c1087-2"
     ]
    },
    {
     "text": "夫妻共同债务应当共同偿还；共同财产不足清偿或者财产归各自所有的，由双方协议清偿，协议不成的由人民法院判决",
     "rules": [
      "c1089-1",
      "c1089-agree",
      "c1089-court"
     ]
    },
    {
     "text": "无过错方有权请求损害赔偿",
     "rules": [
      "c1091"
     ]
    },
    {
     "text": "分割时对实施侵害行为的一方可以少分或者不分；离婚后发现的，另一方可以起诉请求再次分割，诉讼时效三年自发现之日起计算（司法解释）",
     "rules": [
      "c1092-1",
      "c1092-2",
      "c1092-spc84"
     ]
    }
   ],
   "priority": [],
   "distinguish": [
    {
     "text": "第1088条（家务劳动补偿）已在 card:g6809 中形式化（c1088-1、c1088-court），本行不重复",
     "rules": []
    },
    {
     "text": "第1089条只调整夫妻内部清偿，不影响债权人依第1064条向夫妻主张共同债务",
     "rules": []
    },
    {
     "text": "第1092条是离婚时的分割调整；婚内分割见第1066条",
     "rules": []
    }
   ]
  },
