     "rules": [
      "c667-g5149return",
      "c674-g5149pay"
     ]
    },
    {
     "text": "借款人应当按照约定的期限支付利息",
     "rules": [
      "c674-g5149pay"
     ]
    }
   ],
   "exceptions": [
