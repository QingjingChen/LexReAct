  "chapter": [
   "第三编　合同",
   "第二十五章　行纪合同"
  ],
  "nl": {
   "issue": [
    {
     "text": "行纪合同的概念，行纪人的费用负担、价格义务、介入权、提存权、报酬请求权与留置权",
     "rules": [
      "c951-g5812"
     ]
    }
   ],
   "conditions": [
    {
     "text": "行纪人以自己的名义为委托人从事贸易活动，委托人支付报酬",
     "rules": [
      "c951-g5812"
     ]
    },
    {
     "text": "合同生效后就质量、价款或报酬等没有约定或约定不明确的，可协议补充；不能达成的，按合同相关条款或交易习惯确定（第955条第2款援引）",
     "rules": [
      "c510-suppg5812",
      "c510-fillg5812"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "处理委托事务的费用由行纪人负担，另有约定的除外",
     "rules": [
      "c952-g5812"
     ]
    },
    {
     "text": "委托人有相反意思表示的，行纪人不得自己作为买受人或出卖人",
     "rules": [
      "c956-1g5812"
     ]
    },
    {
     "text": "委托人逾期不付报酬的留置权，当事人另有约定的除外",
     "rules": [
      "c959-lieng5812"
     ]
    }
   ],
   "effects": [
    {
     "text": "低于指定价卖出或高于指定价买入应经委托人同意；未经同意但行纪人补偿差额的，买卖对委托人发生效力",
     "rules": [
      "c955-1ag5812",
      "c955-1bg5812"
     ]
    },
    {
     "text": "高于指定价卖出或低于指定价买入的，可按约定增加报酬；无约定或不明确且依第510条仍不能确定的，利益属于委托人",
     "rules": [
      "c955-2ag5812",
      "c955-2bg5812"
     ]
    },
    {
     "text": "委托人对价格有特别指示的，行纪人不得违背",
     "rules": [
      "c955-3g5812"
     ]
    },
    {
     "text": "具有市场定价的商品，行纪人可自己作为买受人或出卖人（介入权），并仍可请求报酬",
     "rules": [
      "c956-1g5812",
      "c956-2g5812"
     ]
    },
    {
     "text": "买入委托物后委托人应及时受领，催告后无正当理由拒绝受领的可提存；委托物不能卖出或委托人撤回出卖，催告后不取回不处分的可提存",
     "rules": [
      "c957-1ag5812",
      "c957-1bg5812",
      "c957-2g5812"
     ]
    },
    {
     "text": "完成或部分完成委托事务的，委托人应支付相应报酬；逾期不付的行纪人对委托物享有留置权",
     "rules": [
      "c959-payg5812",
      "c959-lieng5812"
     ]
    }
   ],
   "priority": [],
   "distinguish": [
    {
     "text": "行纪人以自己名义行事，不同于以被代理人名义的代理和不介入交易的中介；本章未规定的参照适用委托合同",
     "rules": []
    }
   ]
  },
