   "conditions": [
    {
     "text": "合同生效后，就质量、价款或报酬、履行地点等没有约定或约定不明确的，可以协议补充；不能达成补充协议的，按照合同相关条款或者交易习惯确定",
     "rules": [
      "c510-suppg4158",
      "c510-fillg4158"
     ]
    },
    {
     "text": "依第510条仍不能确定的，适用第511条各项任意性补充规则",
     "rules": [
      "c511-q1g4158",
      "c511-priceg4158",
      "c511-placemoneyg4158",
      "c511-termdebtorg4158",
      "c511-methodg4158",
      "c511-costg4158"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "依法应当执行政府定价或者政府指导价的，依照规定履行，不按市场价格",
     "rules": [
      "c511-govpriceg4158"
     ]
    },
    {
     "text": "电子合同当事人对交付商品或者提供服务的方式、时间另有约定的，按照其约定",
     "rules": [
      "c512-agreedg4158"
     ]
    },
    {
     "text": "电子凭证或实物凭证没有载明时间或者载明时间与实际不一致的，以实际提供服务的时间为准",
     "rules": [
      "c512-actualg4158"
     ]
    }
   ],
   "effects": [
    {
     "text": "质量：依次按强制性国家标准、推荐性国家标准、行业标准，均无的按通常标准或者符合合同目的的特定标准",
     "rules": [
      "c511-q1g4158",
      "c511-q2g4158",
      "c511-q3g4158",
      "c511-q4g4158"
     ]
    },
    {
     "text": "价款或者报酬：按订立合同时履行地的市场价格",
     "rules": [
      "c511-priceg4158"
     ]
    },
    {
     "text": "履行地点：给付货币的在接受货币一方所在地；交付不动产的在不动产所在地；其他标的在履行义务一方所在地",
     "rules": [
      "c511-placemoneyg4158",
      "c511-placeimmg4158",
      "c511-placeotherg4158"
     ]
    },
    {
     "text": "履行期限：债务人可以随时履行，债权人也可以随时请求履行，但应当给对方必要的准备时间",
     "rules": [
      "c511-termdebtorg4158",
      "c511-termcreditorg4158",
      "c511-termprepg4158"
     ]
    },
    {
     "text": "履行方式：按照有利于实现合同目的的方式",
     "rules": [
      "c511-methodg4158"
     ]
    },
    {
     "text": "履行费用：由履行义务一方负担；因债权人原因增加的履行费用由债权人负担",
     "rules": [
      "c511-costg4158",
      "c511-extracostg4158"
     ]
    },
    {
     "text": "电子合同：快递交付商品的以收货人签收时间为交付时间；提供服务的以凭证载明时间为提供服务时间；在线传输交付的，以标的物进入对方指定特定系统且能够检索识别的时间为交付时间",
     "rules": [
      "c512-courierg4158",
      "c512-serviceg4158",
      "c512-onlineg4158"
     ]
    }
   ],
   "priority": [
    {
     "text": "当事人约定优先于补充协议，补充协议优先于合同相关条款或交易习惯，后者又优先于第511条的补充规则",
     "rules": [
