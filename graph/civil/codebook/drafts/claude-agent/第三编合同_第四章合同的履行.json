   "conditions": [
    {
     "text": "当事人在订立合同过程中知悉商业秘密或其他应当保密的信息",
     "rules": [
      "c501-noleakg4164",
      "c501-liabg4164"
     ]
    },
    {
     "text": "合同生效后，就质量、价款或报酬、履行地点等没有约定或约定不明确的，先协议补充，不能达成的按合同相关条款或交易习惯确定",
     "rules": [
      "c510-suppg4164",
      "c510-fillg4164"
     ]
    },
    {
     "text": "依第510条仍不能确定的，先适用合同编分则的补充规定（如买卖合同交付地点第603条），再适用第511条通则规定",
     "rules": [
      "c603-carrierg4164",
      "c511-q1g4164"
     ]
    },
    {
     "text": "执行政府定价或者政府指导价的合同发生价格调整",
     "rules": [
      "c513-inperiodg4164"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "依法应当执行政府定价或者政府指导价的，依照规定履行",
     "rules": [
      "c511-govpriceg4164"
     ]
    },
    {
     "text": "电子合同对交付或服务方式、时间另有约定的按约定；凭证未载明或与实际不一致的以实际提供服务时间为准",
     "rules": [
      "c512-agreedg4164",
      "c512-actualg4164"
     ]
    },
    {
     "text": "部分履行不损害债权人利益的，债权人不得拒绝",
     "rules": [
      "c531-refuseg4164"
     ]
    },
    {
     "text": "金钱之债法律另有规定或当事人另有约定的，不适用以实际履行地法定货币履行",
     "rules": [
      "c514-currencyg4164"
     ]
    }
   ],
   "effects": [
    {
     "text": "无论合同是否成立，不得泄露或不正当使用；造成对方损失的，应当赔偿",
     "rules": [
      "c501-noleakg4164",
      "c501-liabg4164"
     ]
    },
    {
     "text": "当事人应按约定全面履行义务；遵循诚信原则，依合同性质、目的和交易习惯履行通知、协助、保密等义务；避免浪费资源、污染环境和破坏生态",
     "rules": [
      "c509-fullg4164",
      "c509-goodfaithg4164",
      "c509-ecog4164"
     ]
    },
    {
     "text": "第511条：质量依次按强制性国家标准、推荐性国家标准、行业标准、通常或符合合同目的的特定标准；价款按订立时履行地市场价格；履行地点按给付货币、交付不动产、其他标的分别确定；期限不明的可随时履行或请求履行但给必要准备时间；方式按有利于合同目的；费用由履行义务一方负担，因债权人原因增加的由债权人负担",
     "rules": [
      "c511-q1g4164",
      "c511-q2g4164",
      "c511-q3g4164",
      "c511-q4g4164",
      "c511-priceg4164",
      "c511-placemoneyg4164",
      "c511-placeimmg4164",
      "c511-placeotherg4164",
      "c511-termdebtorg4164",
      "c511-termcreditorg4164",
      "c511-termprepg4164",
      "c511-methodg4164",
      "c511-costg4164",
      "c511-extracostg4164"
     ]
    },
    {
     "text": "电子合同：快递交付以签收时间、服务以凭证载明时间、在线传输以进入指定系统且可检索识别的时间为交付或服务时间",
     "rules": [
      "c512-courierg4164",
      "c512-serviceg4164",
      "c512-onlineg4164"
     ]
    },
    {
     "text": "政府定价调整：交付期限内调价按交付时价格；逾期交付的涨价按原价、降价按新价；逾期提货或逾期付款的涨价按新价、降价按原价",
     "rules": [
      "c513-latedeliveryupg4164",
      "c513-latedeliverydowng4164",
      "c513-latepickupupg4164",
      "c513-latepickupdowng4164"
     ]
    },
    {
     "text": "金钱之债，债权人可以请求以实际履行地的法定货币履行",
     "rules": [
      "c514-currencyg4164"
     ]
    },
    {
     "text": "债权人可以拒绝部分履行；部分履行给债权人增加的费用由债务人负担",
     "rules": [
      "c531-refuseg4164",
      "c531-costg4164"
     ]
    },
    {
     "text": "买卖合同交付地点：按约定；无约定或不明且依第510条不能确定的，需运输的交给第一承运人，不需运输的在双方订约时知道的标的物所在地交付，不知道的在出卖人订约时营业地交付",
     "rules": [
      "c603-agreedg4164",
      "c603-carrierg4164",
      "c603-knowng4164",
      "c603-knowndefg4164",
      "c603-businessg4164"
     ]
    }
   ],
   "priority": [
    {
     "text": "约定优先，其次协议补充，再次合同相关条款或交易习惯，然后分则特别规定，最后第511条通则规定",
     "rules": [
      "c510-fillg4164",
      "c603-carrierg4164"
     ]
    },
    {
     "text": "买卖合同交付地点的分则规定（第603条）优先于第511条第3项的通则规定",
     "rules": [
      "c603-carrierg4164",
      "c603-knowng4164",
      "c603-businessg4164"
     ]
    },
    {
     "text": "电子合同的另行约定优先于第512条第1、2款的法定时点",
     "rules": [
      "c512-agreedg4164"
     ]
    }
   ],
   "distinguish": [
    {
     "text": "笔记：全面履行规则又称正确履行或适当履行规则，要求按约定的标的、数量、质量、期限、地点、方式全面完成义务；笔记将补充顺序概括为协议补充→合同有关条款/性质/目的/交易习惯→分则→通则",
     "rules": []
    }
   ]
