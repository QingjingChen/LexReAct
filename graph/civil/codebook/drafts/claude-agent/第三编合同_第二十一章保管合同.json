  "chapter": [
   "第三编　合同",
   "第二十一章　保管合同"
  ],
  "nl": {
   "issue": [
    {
     "text": "保管合同的概念、成立，以及保管人与寄存人的权利义务和损害赔偿",
     "rules": [
      "c888-1",
      "c888-2",
      "c890"
     ]
    }
   ],
   "conditions": [
    {
     "text": "保管人保管寄存人交付的保管物并返还该物；顾客在购物、就餐、住宿等场所将物品存放在指定场所的，视为保管（另有约定或交易习惯的除外）",
     "rules": [
      "c888-1",
      "c888-2"
     ]
    },
    {
     "text": "保管合同自保管物交付时成立（实践合同），另有约定的除外",
     "rules": [
      "c890"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "寄存人未告知保管物瑕疵或特殊保管需要致保管物受损的，保管人不赔偿",
     "rules": [
      "c893-2"
     ]
    },
    {
     "text": "无偿保管人证明自己没有故意或重大过失的，不承担赔偿责任",
     "rules": [
      "c897-gratis"
     ]
    },
    {
     "text": "紧急情况或为维护寄存人利益的，可以改变保管场所或方法；转交第三人保管、使用保管物另有约定的除外",
     "rules": [
      "c892-2",
      "c894-1",
      "c895"
     ]
    }
   ],
   "effects": [
    {
     "text": "保管人出具保管凭证（另有交易习惯的除外），妥善保管，不得擅自改变约定的保管场所或方法",
     "rules": [
      "c891",
      "c892-1",
      "c892-2"
     ]
    },
    {
     "text": "寄存人对保管物瑕疵或特殊保管需要负告知义务；未告知致保管人受损的应赔偿，但保管人知道或应当知道且未采取补救措施的除外",
     "rules": [
      "c893-1",
      "c893-3"
     ]
    },
    {
     "text": "保管人不得转交第三人保管，违反并造成损失的应赔偿；不得使用或许可第三人使用保管物",
     "rules": [
      "c894-1",
      "c894-2",
      "c895"
     ]
    },
    {
     "text": "第三人主张权利的，除依法保全或执行外仍应向寄存人返还；第三人起诉或申请扣押的应及时通知寄存人",
     "rules": [
      "c896-1",
      "c896-2"
     ]
    },
    {
     "text": "保管期内因保管不善致保管物毁损灭失的，保管人应赔偿",
     "rules": [
      "c897-1",
      "c897-comp"
     ]
    },
    {
     "text": "寄存货币、有价证券或其他贵重物品应声明并由保管人验收或封存；未声明的，毁损灭失后可按一般物品赔偿",
     "rules": [
      "c898-1",
      "c898-2"
     ]
    },
    {
     "text": "寄存人可随时领取；无期限或期限不明的保管人可随时请求领取；约定期限的无特别事由不得请求提前领取",
     "rules": [
      "c899-1",
      "c899-2",
      "c899-3"
     ]
    },
    {
     "text": "期限届满或提前领取时返还原物及孳息；货币可返还同种类数量的货币，其他可替代物按约定可返还同种类、品质、数量的物品",
     "rules": [
      "c900",
      "c901-1",
      "c901-2"
     ]
    }
   ],
   "priority": [
    {
     "text": "寄存人未告知致损的免责、无偿保管人无故意或重大过失的免责，优先于保管不善的一般赔偿规则",
     "rules": [
      "c893-2",
      "c897-gratis"
     ]
    }
   ],
   "distinguish": [
    {
     "text": "仓储合同为有偿、诺成合同；保管合同原则上为实践合同，可有偿可无偿",
     "rules": []
    }
   ]
  },
