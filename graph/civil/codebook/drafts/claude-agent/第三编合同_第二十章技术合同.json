  "chapter": [
   "第三编　合同",
   "第二十章　技术合同"
  ],
  "nl": {
   "issue": [
    {
     "text": "技术合同的概念与类型；技术成果的归属；技术开发、转让许可、咨询服务合同中当事人的主要义务",
     "rules": [
      "c843",
      "c847-2",
      "c851-def",
      "c862-1",
      "c862-2",
      "c878-1",
      "c878-2"
     ]
    }
   ],
   "conditions": [
    {
     "text": "技术合同：就技术开发、转让、许可、咨询或服务订立的合同；技术开发合同包括委托开发与合作开发，科技成果转化合同参照适用",
     "rules": [
      "c843",
      "c851-def",
      "c851-types",
      "c851-4"
     ]
    },
    {
     "text": "职务技术成果：执行单位工作任务或主要利用单位物质技术条件完成",
     "rules": [
      "c847-2"
     ]
    },
    {
     "text": "技术转让合同（专利权、专利申请权、技术秘密转让）与技术许可合同（专利实施许可、技术秘密使用许可）",
     "rules": [
      "c862-1",
      "c862-2",
      "c863-1",
      "c863-2"
     ]
    },
    {
     "text": "技术咨询合同提供可行性论证等；技术服务合同解决特定技术问题，不包括承揽合同和建设工程合同",
     "rules": [
      "c878-1",
      "c878-2"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "专利申请权归属、优先受让权、放弃后的申请：法律另有规定或当事人另有约定的除外",
     "rules": [
      "c859-pat",
      "c860-own",
      "c860-pre",
      "c860-waive"
     ]
    },
    {
     "text": "委托开发的研究开发人不得在向委托人交付成果前将成果转让给第三人",
     "rules": [
      "c861-proviso"
     ]
    },
    {
     "text": "按符合约定的咨询报告决策造成的损失由委托人承担，但另有约定的除外；咨询服务中新技术成果归属另有约定的从约定",
     "rules": [
      "c881-3",
      "c885-agreed"
     ]
    }
   ],
   "effects": [
    {
     "text": "技术合同一般条款；有关技术文档经约定可作为合同组成部分；涉及专利应注明专利信息",
     "rules": [
      "c845-2",
      "c845-3"
     ]
    },
    {
     "text": "职务成果由单位订立技术合同，转让时完成人有同等条件优先受让权；非职务成果由完成人订立技术合同；完成人享有署名权与荣誉、奖励权",
     "rules": [
      "c847-1",
      "c847-pre",
      "c848",
      "c849"
     ]
    },
    {
     "text": "非法垄断技术或侵害他人技术成果的技术合同无效",
     "rules": [
      "c850"
     ]
    },
    {
     "text": "技术开发合同、技术转让和许可合同应当采用书面形式",
     "rules": [
      "c851-3",
      "c863-3"
     ]
    },
    {
     "text": "委托开发：委托人付费、提供资料、提出要求、协作、接受成果；研究开发人制定实施计划、合理使用经费、按期完成交付并指导；违约致开发停滞、延误或失败的承担违约责任",
     "rules": [
      "c852",
      "c853",
      "c854"
     ]
    },
    {
     "text": "合作开发当事人按约定投资、分工参与、协作配合",
     "rules": [
      "c855"
     ]
    },
    {
     "text": "标的技术已由他人公开致履行无意义的，当事人可以解除合同",
     "rules": [
      "c857"
     ]
    },
    {
     "text": "委托开发的发明创造申请专利的权利属研究开发人，委托人可依法实施，研究开发人转让时委托人有优先受让权",
     "rules": [
      "c859-pat",
      "c859-use",
      "c859-pre"
     ]
    },
    {
     "text": "合作开发的申请专利的权利共有；一方转让时其他方优先受让；一方放弃的他方可申请，放弃方可免费实施；一方不同意申请的，他方不得申请",
     "rules": [
      "c860-own",
      "c860-pre",
      "c860-waive",
      "c860-free",
      "c860-3"
     ]
    },
    {
     "text": "技术秘密成果的使用、转让和收益分配从约定；无约定且依第510条仍不能确定的，在相同方案获专利前各方均可使用和转让",
     "rules": [
      "c861-agreed",
      "c861-default"
     ]
    },
    {
     "text": "专用设备、原材料、技术咨询服务的约定属于转让、许可合同的组成部分",
     "rules": [
      "c862-3"
     ]
    },
    {
     "text": "专利实施许可：许可人许可实施、交付资料并指导；被许可人按约实施、不得许可约定外第三人实施、支付使用费",
     "rules": [
      "c866",
      "c867"
     ]
    },
    {
     "text": "让与人、许可人保证是技术的合法拥有者，且技术完整、无误、有效，能达到约定目标",
     "rules": [
      "c870"
     ]
    },
    {
     "text": "技术咨询：委托人阐明问题、提供资料、接受成果、付酬；受托人按期按要求完成报告；委托人未协作或不接受成果的报酬不得追回、未付应付；受托人违约的减收或免收报酬",
     "rules": [
      "c879",
      "c880",
      "c881-1",
      "c881-2"
     ]
    },
    {
     "text": "技术服务：委托人提供工作条件、配合、接受成果并付酬；受托人完成服务、解决问题、保证质量并传授知识",
     "rules": [
      "c882",
      "c883"
     ]
    },
    {
     "text": "咨询、服务中利用委托人资料和条件完成的新成果归受托人；利用受托人工作成果完成的新成果归委托人；工作费用负担无约定的由受托人负担",
     "rules": [
      "c885-party",
      "c885-client",
      "c885-1",
      "c885-2",
      "c886"
     ]
    }
   ],
   "priority": [
    {
     "text": "研究开发人交付前不得转让的但书优先于第861条各方均可转让的规则；咨询服务新成果的约定归属优先于法定归属",
     "rules": [
      "c861-proviso",
      "c885-agreed"
     ]
    }
   ],
   "distinguish": [
    {
     "text": "技术开发合同的客体是尚不存在、有待开发的技术成果；技术服务合同解决已有技术问题；技术转让移转权利，技术许可仅许可实施、使用",
     "rules": []
    }
   ]
  },
