      "c1131-perm"
     ]
    }
   ],
   "conditions": [
    {
     "text": "继承人以外的依靠被继承人扶养的人，或者继承人以外的对被继承人扶养较多的人",
     "rules": [
      "c1131-elig"
     ]
    },
    {
     "text": "被收养人对养父母尽了赡养义务，同时又对生父母扶养较多的，可分得生父母适当的遗产（继承编解释一第10条）",
     "rules": [
      "c1131-spc10"
     ]
