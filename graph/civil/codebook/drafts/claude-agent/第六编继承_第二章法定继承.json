  "nl": {
   "issue": [
    {
     "text": "法定继承中同一顺序继承人的遗产份额如何确定，何时可以不均等",
     "rules": [
      "c1130-1",
      "c1130-2",
      "c1130-3",
      "c1130-4",
      "c1130-5"
     ]
    }
   ],
   "conditions": [
    {
     "text": "一般情形：法定继承的同一顺序继承人份额一般应当均等",
     "rules": [
      "c1130-1"
     ]
    },
    {
     "text": "尽了主要扶养义务的认定：对被继承人生活提供了主要经济来源，或者在劳务等方面给予了主要扶助",
     "rules": [
      "c1130-spc19"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "生活有特殊困难又缺乏劳动能力的继承人，分配遗产时应当予以照顾",
     "rules": [
      "c1130-2"
     ]
    },
    {
     "text": "对被继承人尽了主要扶养义务或者与被继承人共同生活的继承人，可以多分",
     "rules": [
      "c1130-3"
     ]
    },
    {
     "text": "有扶养能力和扶养条件而不尽扶养义务的继承人，应当不分或者少分",
     "rules": [
      "c1130-4"
     ]
    },
    {
     "text": "继承人协商同意的，也可以不均等",
     "rules": [
      "c1130-5"
     ]
    },
    {
     "text": "代位继承人缺乏劳动能力又没有生活来源，或者对被继承人尽过主要赡养义务的，可以多分（继承编解释一第16条）",
     "rules": [
      "c1130-spc16"
     ]
    }
   ],
   "effects": [
    {
     "text": "存在照顾、多分、不分少分或协商不均等事由的，排除均等分配",
     "rules": [
      "c1130-1",
      "c1130-2",
      "c1130-3",
      "c1130-4",
      "c1130-5"
     ]
    }
   ],
   "priority": [
