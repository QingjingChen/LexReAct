     ]
    }
   ],
   "conditions": [
    {
     "text": "遗产分割的时间、办法和份额由继承人协商确定；协商不成的，可以调解或起诉",
     "rules": [
      "c1132-agree",
      "c1132-fail"
     ]
    },
    {
     "text": "遗产管理人：遗嘱执行人；无遗嘱执行人的由继承人及时推选；未推选的由继承人共同担任；没有继承人或继承人均放弃继承的，由被继承人生前住所地的民政部门或者村民委员会担任",
     "rules": [
      "c1145-exec",
      "c1145-elect",
      "c1145-elected",
      "c1145-joint",
      "c1145-none"
     ]
    },
    {
     "text": "对遗产管理人的确定有争议的，利害关系人可以申请人民法院指定",
     "rules": [
      "c1146"
     ]
    }
   ],
   "exceptions": [
    {
     "text": "夫妻共同财产先分出一半归配偶，但有约定的除外",
     "rules": [
      "c1153-1"
     ]
    },
    {
     "text": "继承人对超过遗产实际价值部分自愿偿还的，不受限定继承的限制",
     "rules": [
      "c1161-vol"
     ]
    },
    {
     "text": "放弃继承的，对被继承人的税款和债务可以不负清偿责任",
     "rules": [
      "c1161-2"
     ]
    },
    {
     "text": "胎儿娩出时是死体的，保留的份额按照法定继承办理",
     "rules": [
      "c1155-2"
     ]
    }
   ],
   "effects": [
    {
     "text": "遗产管理人应当履行清理遗产并制作清单、报告、防止毁损灭失、处理债权债务、分割遗产及其他必要行为等职责",
     "rules": [
      "c1147"
     ]
    },
    {
     "text": "遗产管理人应当依法履行职责；因故意或者重大过失造成继承人、受遗赠人、债权人损害的，应当承担民事责任",
     "rules": [
      "c1148-1",
      "c1148-2"
     ]
    },
    {
     "text": "遗产管理人可以依照法律规定或者按照约定获得报酬",
     "rules": [
      "c1149"
     ]
    },
    {
     "text": "遗产在家庭共有财产之中的，先分出他人的财产；与其他共有人的共有财产同理（笔记、学理）",
     "rules": [
      "c1153-2",
      "c1153-other"
     ]
    },
    {
     "text": "遗产分割时应当保留胎儿的继承份额；应保留而未保留的，从继承人所继承的遗产中扣回；胎儿出生后死亡的，保留份额由其继承人继承（继承编解释一第31条）",
     "rules": [
      "c1155-1",
      "c1155-spc31a",
      "c1155-spc31b"
     ]
    },
    {
     "text": "遗产分割应当有利于生产和生活需要，不损害遗产效用；不宜分割的，可以折价、适当补偿或者共有；分割房屋、生产资料和特定职业所需财产时兼顾使用效益与实际需要（继承编解释一第42条）",
     "rules": [
      "c1156-1",
      "c1156-2",
      "c1156-spc42"
     ]
    },
    {
     "text": "继承人以所得遗产实际价值为限清偿被继承人依法应当缴纳的税款和债务",
     "rules": [
      "c1161-1"
     ]
    }
   ],
   "priority": [
    {
     "text": "分割遗产应当先清偿税款和债务，但是应当为缺乏劳动能力又没有生活来源的继承人保留必要的遗产（必留份优先于债务清偿）",
     "rules": [
      "c1159-1",
      "c1159-2"
     ]
    },
    {
     "text": "执行遗赠不得妨碍清偿遗赠人依法应当缴纳的税款和债务（清偿债务优先于执行遗赠）",
     "rules": [
      "c1162"
     ]
    },
    {
     "text": "既有法定继承又有遗嘱继承、遗赠的，先由法定继承人清偿；超过法定继承遗产实际价值部分，由遗嘱继承人和受遗赠人按比例以所得遗产清偿",
     "rules": [
      "c1163-1",
      "c1163-2"
     ]
    },
    {
     "text": "遗嘱执行人优先担任遗产管理人；推选、共同担任、民政部门或村委会担任依次补充",
     "rules": [
      "c1145-exec",
      "c1145-elected",
      "c1145-joint",
      "c1145-none"
     ]
    }
   ],
