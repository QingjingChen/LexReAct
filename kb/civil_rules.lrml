            <lrml:ConstitutiveStatement key="tx-g8072"><lrml:Comment>分类（自动抽取自图的层级）：发表权 ⊑ 著作人身权</lrml:Comment><ruleml:Rule closure="universal" key=":tx-g8072"><ruleml:if><ruleml:Atom><ruleml:Rel iri="cnv:isA"/><ruleml:Var>X</ruleml:Var><ruleml:Ind>发表权</ruleml:Ind></ruleml:Atom></ruleml:if><ruleml:then><ruleml:Atom><ruleml:Rel iri="cnv:isA"/><ruleml:Var>X</ruleml:Var><ruleml:Ind>著作人身权</ruleml:Ind></ruleml:Atom></ruleml:then></ruleml:Rule></lrml:ConstitutiveStatement>
              <lrml:ConstitutiveStatement key="tx-g8090"><lrml:Comment>分类（自动抽取自图的层级）：修改权 ⊑ 著作人身权</lrml:Comment><ruleml:Rule closure="universal" key=":tx-g8090"><ruleml:if><ruleml:Atom><ruleml:Rel iri="cnv:isA"/><ruleml:Var>X</ruleml:Var><ruleml:Ind>修改权</ruleml:Ind></ruleml:Atom></ruleml:if><ruleml:then><ruleml:Atom><ruleml:Rel iri="cnv:isA"/><ruleml:Var>X</ruleml:Var><ruleml:Ind>著作人身权</ruleml:Ind></ruleml:Atom></ruleml:then></ruleml:Rule></lrml:ConstitutiveStatement>
