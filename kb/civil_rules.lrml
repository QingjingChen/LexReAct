    <lrml:Association><lrml:appliesSource keyref="#cc-art145-1"/><lrml:appliesAuthority keyref="#npc"/><lrml:appliesTemporalCharacteristics keyref="#tb-cc"/><lrml:appliesStrength iri="lrmlv:Defeasible"/><lrml:toTarget keyref="#c145-pending"/></lrml:Association>
