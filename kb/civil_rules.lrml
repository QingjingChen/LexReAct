              <lrml:ConstitutiveStatement key="tx-g8127"><lrml:Comment>分类（自动抽取自图的层级）：表演权 ⊑ 著作财产权</lrml:Comment><ruleml:Rule closure="universal" key=":tx-g8127"><ruleml:if><ruleml:Atom><ruleml:Rel iri="cnv:isA"/><ruleml:Var>X</ruleml:Var><ruleml:Ind>表演权</ruleml:Ind></ruleml:Atom></ruleml:if><ruleml:then><ruleml:Atom><ruleml:Rel iri="cnv:isA"/><ruleml:Var>X</ruleml:Var><ruleml:Ind>著作财产权</ruleml:Ind></ruleml:Atom></ruleml:then></ruleml:Rule></lrml:ConstitutiveStatement>
              <lrml:ConstitutiveStatement key="tx-g8142"><lrml:Comment>分类（自动抽取自图的层级）：放映权 ⊑ 著作财产权</lrml:Comment><ruleml:Rule closure="universal" key=":tx-g8142"><ruleml:if><ruleml:Atom><ruleml:Rel iri="cnv:isA"/><ruleml:Var>X</ruleml:Var><ruleml:Ind>放映权</ruleml:Ind></ruleml:Atom></ruleml:if><ruleml:then><ruleml:Atom><ruleml:Rel iri="cnv:isA"/><ruleml:Var>X</ruleml:Var><ruleml:Ind>著作财产权</ruleml:Ind></ruleml:Atom></ruleml:then></ruleml:Rule></lrml:ConstitutiveStatement>
              <lrml:ConstitutiveStatement key="tx-g8146"><lrml:Comment>分类（自动抽取自图的层级）：广播权 ⊑ 著作财产权</lrml:Comment><ruleml:Rule closure="universal" key=":tx-g8146"><ruleml:if><ruleml:Atom><ruleml:Rel iri="cnv:isA"/><ruleml:Var>X</ruleml:Var><ruleml:Ind>广播权</ruleml:Ind></ruleml:Atom></ruleml:if><ruleml:then><ruleml:Atom><ruleml:Rel iri="cnv:isA"/><ruleml:Var>X</ruleml:Var><ruleml:Ind>著作财产权</ruleml:Ind></ruleml:Atom></ruleml:then></ruleml:Rule></lrml:ConstitutiveStatement>
